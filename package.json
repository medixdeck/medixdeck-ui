{
  "name": "@medixdeck/ui",
  "version": "0.1.21",
  "description": "MedixDeck shared UI component library — built with Chakra UI v3 and Vite",
  "author": "MedixDeck Team",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/medixdeck/medixdeck-ui#readme",
  "bugs": {
    "url": "https://github.com/medixdeck/medixdeck-ui/issues"
  },
  "engines": {
    "node": ">=20.16",
    "npm": ">=9"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:app": "vite build -c vite.app.config.ts",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "prepare": "husky",
    "release": "npm version patch && npm publish --public",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@chakra-ui/react": ">=3.0.0",
    "framer-motion": ">=11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tiptap/react": ">=3.0.0",
    "@tiptap/pm": ">=3.0.0",
    "@tiptap/starter-kit": ">=3.0.0",
    "@tiptap/extension-link": ">=3.0.0",
    "@tiptap/extension-underline": ">=3.0.0",
    "@tiptap/extension-text-align": ">=3.0.0",
    "@tiptap/extension-placeholder": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.21.0",
    "@emotion/react": "^11.13.0",
    "@happy-dom/global-registrator": "^20.9.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^16.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "react-icons": "^5.6.0",
    "storybook": "^8.6.18",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.4",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/extension-text-align": "^3.29.1",
    "@tiptap/extension-underline": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1"
  },
  "dependencies": {
    "framer-motion": ">=11.0.0",
    "isomorphic-dompurify": "^3.16.0",
    "next-themes": "^0.4.4",
    "react-cookie-consent": "^10.0.1",
    "react-country-flag": "^3.1.0",
    "react-markdown": "^10.1.0"
  },
  "keywords": [
    "medixdeck",
    "ui",
    "components",
    "design-system",
    "chakra-ui",
    "react",
    "healthcare"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/medixdeck/medixdeck-ui.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
