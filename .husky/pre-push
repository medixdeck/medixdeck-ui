#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🎨 Running Prettier..."
npm run format

echo "🔍 Running ESLint auto-fix..."
npm run lint:fix
LINT_EXIT_CODE=$?

# If files were modified by the tools, commit them automatically
if ! git diff --quiet; then
  echo "📦 Auto-committing format/lint changes..."
  git add -A
  git commit -m "chore: auto-format and lint fixes [skip ci]"
fi

# Abort if lint:fix failed
if [ $LINT_EXIT_CODE -ne 0 ]; then
  echo "❌ Push aborted: ESLint found unfixable errors. Please resolve them manually."
  exit $LINT_EXIT_CODE
fi

echo "✅  All checks passed. Pushing..."
